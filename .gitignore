# ==== Django static & media ====
# Keep *source* static (e.g., app/static/) in Git.
# Ignore only collected static (STATIC_ROOT) and all media/user uploads.
staticfiles/
static_root/
static_collected/
**/static_collected/

# Media / user uploads (ignore everywhere)
media/
**/media/**
uploads/
**/uploads/**
user_uploads/
**/user_uploads/**
public/media/
**/public/media/**
storage/
**/storage/**

# Optionally keep the folder structure on servers
!media/.keep
!uploads/.keep
!user_uploads/.keep
!public/media/.keep
!storage/.keep
